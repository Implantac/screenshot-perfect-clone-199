# ---------------------------------------------------------------------------
# JARVIS (opcional, server-side — NUNCA usar prefixo VITE_ nestas variáveis)
# Sem chave configurada o JARVIS responde pelo analista local determinístico.
# ---------------------------------------------------------------------------
# JARVIS_LLM_PROVIDER=openai        # openai | anthropic | gemini
# JARVIS_LLM_API_KEY=
# JARVIS_LLM_MODEL=gpt-4o-mini
# JARVIS_LLM_BASE_URL=              # opcional: gateway/proxy/Azure/mock
#
# Ferramentas (wave 21): funcionam SEM chave de LLM. O roteador escolhe a
# ferramenta pela pergunta, o motor calcula o número e o analista local responde.
# Com chave, o modelo apenas redige sobre o resultado já calculado.
#
# Aprovação de escrita: nenhuma variável de ambiente é necessária — as propostas
# ficam em public.jarvis_proposals (migration 20261030260000) e só são gravadas
# depois de aprovação explícita na tela do chat.

# ---------------------------------------------------------------------------
# Trilha de auditoria (wave 25) — assinatura assimétrica das âncoras
# Gere o par com:  bun run scripts/audit-keys.ts --env
# A PRIVADA fica só no servidor. A PÚBLICA vai no pacote do auditor, que assim
# verifica a âncora com `openssl dgst -sha256 -verify` e NÃO consegue assinar outra.
# Guarde as quebras de linha como \n (o código normaliza).
# AUDIT_SIGNING_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
# AUDIT_SIGNING_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----\n"
# Confira o par a qualquer momento:  bun run scripts/audit-keys.ts --verify

# Trilha de auditoria (wave 20) — assinatura simétrica (legado, ainda verificável)
# Sem segredo, a âncora é emitida SEM assinatura e a tela declara a pendência.
# Gere com: openssl rand -hex 32
# ---------------------------------------------------------------------------
# AUDIT_SIGNING_SECRET=
